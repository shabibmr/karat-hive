model Review {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId        String       @map("connection_id") @db.Uuid
  authorType          AuthorType   @map("author_type")
  authorUserId        String       @map("author_user_id") @db.Uuid
  subjectUserId       String       @map("subject_user_id") @db.Uuid
  rating              Int
  comment             String?
  state               ReviewState
  vendorResponse      String?      @map("vendor_response")
  vendorResponseState ReviewState? @map("vendor_response_state")
  moderatedByAdminId  String?      @map("moderated_by_admin_id") @db.Uuid
