# Copy to backend/.env
#
# Option A — Local PostgreSQL (no Docker). Create database `karat_hive` yourself.
DATABASE_URL="postgresql://karat:karat@localhost:5432/karat_hive"
#
# Option B — Supabase-managed PostgreSQL (project ref husuemlfcvacrysapwho).
# Direct connection (migrations + app). URL-encode reserved chars in the password
# (e.g. `@` -> `%40`). Get/reset the password in Dashboard > Project Settings > Database.
#   DATABASE_URL="postgresql://postgres:<PASSWORD>@db.husuemlfcvacrysapwho.supabase.co:5432/postgres?sslmode=require"
# Transaction pooler (for serverless / many short-lived connections) — append ?pgbouncer=true:
#   DATABASE_URL="postgresql://postgres.husuemlfcvacrysapwho:<PASSWORD>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
KH_ROLE=api
# APP_ROLE is a one-release alias for KH_ROLE (Architecture §6).
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET="local-dev-jwt-access-secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=14

# --- OTP (vendor onboarding vertical) ---
# console: code is logged by the backend. fixed: code is always OTP_FIXED_CODE.
OTP_DEV_MODE=console
OTP_FIXED_CODE=000000
OTP_TTL_SECONDS=300
OTP_MAX_PER_NUMBER_PER_HOUR=5

# --- password-login lockout (FR-VEN-003) ---
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=10

# --- Supabase Storage (KYC documents). Required outside NODE_ENV=test. ---
# Service-role key: Dashboard > Project Settings > API > service_role (secret). Never ship to a client.
SUPABASE_URL="https://husuemlfcvacrysapwho.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET_KYC=kyc
SIGNED_UPLOAD_TTL_SECONDS=900

# --- dev-only vendor verification shortcut (never true in production) ---
DEV_VERIFY_ENABLED=false
DEV_VERIFY_KEY=""
